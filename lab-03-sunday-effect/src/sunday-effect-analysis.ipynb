      "source": "fig, axes = plt.subplots(1, 2, figsize=(15, 6))\nfig.suptitle(\"Distribution des montants — Dimanche vs Autres jours\", fontsize=14, fontweight='bold')\n\ncouleurs = {True: '#E85D04', False: '#2196F3'}\nlabels   = {True: 'Dimanche', False: 'Autres jours'}\n\n# Histogramme\nfor val, grp in df_propre.groupby('is_dimanche'):\n    axes[0].hist(grp['montant'], bins=30, alpha=0.65, color=couleurs[val],\n                 label=labels[val], density=False, edgecolor='white')\naxes[0].set_title('Histogramme des montants')\naxes[0].set_xlabel('Montant (MAD)')\naxes[0].set_ylabel('Fréquence')\naxes[0].legend()\n\n# Boxplot\ndata_bp = [df_autres['montant'], df_dimanche['montant']]\nbp = axes[1].boxplot(data_bp, patch_artist=True, widths=0.5,\n                     medianprops=dict(color='black', linewidth=2))\nfor patch, color in zip(bp['boxes'], ['#2196F3','#E85D04']):\n    patch.set_facecolor(color)\n    patch.set_alpha(0.7)\naxes[1].set_xticks([1, 2])\naxes[1].set_xticklabels(['Autres jours', 'Dimanche'])\naxes[1].set_title('Boxplot des montants')\naxes[1].set_ylabel('Montant (MAD)')\n\nsns.despine(fig=fig)\nplt.tight_layout()\nplt.savefig('../docs/distribution-amounts-plot.png', dpi=150, bbox_inches='tight')\nplt.show()\nprint(\"Graphique sauvegardé.\")",
