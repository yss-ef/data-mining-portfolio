    {
      "id": "9da1c611-dcb2-4b32-8cb9-a85192bd0699",
      "cell_type": "code",
      "source": "# Puisque Q15 ne retourne aucun dominant \"officiel\", on teste la robustesse\n# des 3 produits phares (Souris, Smartphone, Écouteurs) sur les 6 villes.\n# Critère local : delta > 0 dans la ville (part_dim_locale > part_autres_locale)\n\nvilles = sorted(df_propre['ville'].unique())\nresultats = []\n\nfor ville in villes:\n    d_v = df_dimanche[df_dimanche['ville'] == ville]\n    a_v = df_autres  [df_autres  ['ville'] == ville]\n    row = {'Ville': ville}\n    for prod in ['Souris','Smartphone','Ecouteurs']:\n        p_d = d_v[d_v['produit']==prod]['montant'].sum() / d_v['montant'].sum() * 100 if len(d_v)>0 else 0\n        p_a = a_v[a_v['produit']==prod]['montant'].sum() / a_v['montant'].sum() * 100 if len(a_v)>0 else 0\n        delta_local = p_d - p_a\n        row[f'{prod}_part_dim(%)']   = round(p_d, 1)\n        row[f'{prod}_delta']         = round(delta_local, 1)\n        row[f'{prod}_surperformant'] = '' if delta_local > 0 else '❌'\n    resultats.append(row)\n\ndf_robustesse = pd.DataFrame(resultats)\ndisplay(df_robustesse)\n\nprint()\nfor prod in ['Souris','Smartphone','Ecouteurs']:\n    n_ok  = sum(1 for r in resultats if r[f'{prod}_surperformant'] == '')\n    pct   = n_ok / len(villes) * 100\n    concl = \"Robuste (≥ 60%)\" if pct >= 60 else \"❌ Non robuste (< 60%)\"\n    print(f\"  {prod:12s} : surperformant dans {n_ok}/{len(villes)} villes = {pct:.0f}% → {concl}\")",
