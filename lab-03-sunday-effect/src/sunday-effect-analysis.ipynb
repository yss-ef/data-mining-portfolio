      "source": "---\n## 1. Dictionnaire de données\n\n### Q0. Dictionnaire minimal des colonnes utilisées",
      "metadata": {}
    },
    {
      "id": "a103afd5-ebbb-4021-8451-c46e0a62fab5",
      "cell_type": "code",
      "source": "dictionnaire = pd.DataFrame([\n    {\"nom\": \"date\",           \"type\": \"date (object → datetime64)\", \"definition\": \"Date de la transaction\",\n     \"unite_ou_domaine\": \"YYYY-MM-DD\",            \"contraintes\": \"Non nul, >= 2024-01-01\",\n     \"traitement\": \"Conversion en datetime64 ; variable dérivée is_dimanche (dayofweek == 6)\"},\n    {\"nom\": \"ville\",          \"type\": \"string (catégoriel)\",        \"definition\": \"Ville du magasin\",\n     \"unite_ou_domaine\": \"{Casablanca, Rabat, Marrakech, Fes, Agadir, Tanger}\",\n     \"contraintes\": \"Non nul ; 6 valeurs distinctes\",\n     \"traitement\": \"Utilisé pour le test de robustesse géographique (Q16)\"},\n    {\"nom\": \"transaction_id\", \"type\": \"string (identifiant)\",       \"definition\": \"Identifiant unique du ticket de caisse\",\n     \"unite_ou_domaine\": \"Chaîne alphanumérique\",  \"contraintes\": \"Non nul\",\n     \"traitement\": \"Comptage du support par produit (nb de lignes distinctes)\"},\n    {\"nom\": \"categorie\",      \"type\": \"string (catégoriel)\",        \"definition\": \"Catégorie du produit\",\n     \"unite_ou_domaine\": \"{Alimentaire, Vêtements, High-Tech, …}\", \"contraintes\": \"Non nul\",\n     \"traitement\": \"Contexte pour les recommandations stratégiques\"},\n    {\"nom\": \"produit\",        \"type\": \"string (catégoriel)\",        \"definition\": \"Nom du produit vendu\",\n     \"unite_ou_domaine\": \"Libellé produit\",         \"contraintes\": \"Non nul ; axe d'analyse principal\",\n     \"traitement\": \"Groupby pour calcul du CA et parts de marché\"},\n    {\"nom\": \"prix_unitaire\",  \"type\": \"float\",                      \"definition\": \"Prix de vente d'une unité avant remise\",\n     \"unite_ou_domaine\": \"MAD (> 0)\",               \"contraintes\": \"Strictement positif\",\n     \"traitement\": \"Composante du calcul du montant net\"},\n    {\"nom\": \"quantite\",       \"type\": \"int\",                        \"definition\": \"Nombre d'unités achetées\",\n     \"unite_ou_domaine\": \"Entier ≥ 1\",              \"contraintes\": \"Strictement positif\",\n     \"traitement\": \"Composante du calcul du montant net\"},\n    {\"nom\": \"remise_pct\",     \"type\": \"float\",                      \"definition\": \"Taux de remise accordé (%)\",\n     \"unite_ou_domaine\": \"[0, 100]\",                \"contraintes\": \"Peut être nul (pas de remise) ou manquant\",\n     \"traitement\": \"Imputation à 0 (absence de remise) ; composante du montant net\"},\n    {\"nom\": \"moyen_paiement\", \"type\": \"string (catégoriel)\",        \"definition\": \"Mode de paiement utilisé\",\n     \"unite_ou_domaine\": \"{Carte, En ligne, Especes}\", \"contraintes\": \"Non nul après harmonisation\",\n     \"traitement\": \"Harmonisation des libellés : CB/carte → Carte, En-ligne → En ligne\"},\n    {\"nom\": \"montant\",        \"type\": \"float (variable dérivée)\",   \"definition\": \"CA net de la ligne d'achat\",\n     \"unite_ou_domaine\": \"MAD (> 0)\",               \"contraintes\": \"Doit être strictement positif\",\n     \"traitement\": \"Calculé via : prix_unitaire × quantite × (1 − remise_pct/100)\"},\n])\n\ndictionnaire.to_csv('../data/data-dictionary.csv', index=False)\nprint(\"Fichier 'data-dictionary.csv' sauvegardé.\")\ndisplay(dictionnaire.style.set_properties(**{'text-align': 'left'}).set_table_styles(\n    [{'selector': 'th', 'props': [('text-align', 'center')]}]))",
