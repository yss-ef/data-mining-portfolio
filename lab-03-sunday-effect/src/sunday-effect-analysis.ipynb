            "text/html": "<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>produit</th>\n      <th>ca_dimanche</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>26</th>\n      <td>Souris</td>\n      <td>73092.1165</td>\n    </tr>\n    <tr>\n      <th>25</th>\n      <td>Smartphone</td>\n      <td>70137.3360</td>\n    </tr>\n    <tr>\n      <th>10</th>\n      <td>Ecouteurs</td>\n      <td>51922.8570</td>\n    </tr>\n    <tr>\n      <th>30</th>\n      <td>Tablette</td>\n      <td>30614.6010</td>\n    </tr>\n    <tr>\n      <th>7</th>\n      <td>Clavier</td>\n      <td>30554.0920</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>Casque</td>\n      <td>27712.4360</td>\n    </tr>\n    <tr>\n      <th>29</th>\n      <td>Table</td>\n      <td>23968.7210</td>\n    </tr>\n    <tr>\n      <th>16</th>\n      <td>Miroir</td>\n      <td>23672.5640</td>\n    </tr>\n    <tr>\n      <th>8</th>\n      <td>Coussin</td>\n      <td>23056.7815</td>\n    </tr>\n    <tr>\n      <th>0</th>\n      <td>Ballon</td>\n      <td>22181.8260</td>\n    </tr>\n  </tbody>\n</table>\n</div>"
          },
          "metadata": {}
        }
      ],
      "execution_count": 12
    },
    {
      "id": "ecbe7a2f-8091-4427-affe-714ad136fb5f",
      "cell_type": "markdown",
      "source": "### Q12. Part de CA (%) par produit",
      "metadata": {}
    },
    {
      "id": "831ba4a1-5a4a-428f-9ed4-f7d98683a1e3",
      "cell_type": "code",
      "source": "ca_dimanche['part_dimanche (%)'] = ca_dimanche['ca_dimanche'] / ca_dimanche['ca_dimanche'].sum() * 100\nca_autres  ['part_autres_jours (%)'] = ca_autres  ['ca_autres_jours'] / ca_autres['ca_autres_jours'].sum() * 100\n\ndf_comparatif = pd.merge(ca_dimanche, ca_autres, on='produit', how='outer').fillna(0)\nprint(\"Parts de CA calculées.\")",
      "metadata": {
        "trusted": true
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": "Parts de CA calculées.\n"
        }
      ],
      "execution_count": 13
    },
    {
      "id": "5b689630-ec76-4472-827f-52fdc90b168e",
      "cell_type": "markdown",
      "source": "### Q13. Top-3 produits du dimanche",
      "metadata": {}
    },
    {
      "id": "1add1ddc-24b5-4671-86bf-5766602fa1d2",
      "cell_type": "code",
      "source": "top3 = df_comparatif.sort_values('part_dimanche (%)', ascending=False).head(3)\nprint(\"--- Top-3 produits générant le plus de CA le Dimanche ---\")\ndisplay(top3[['produit','part_dimanche (%)']].round(2).reset_index(drop=True))",
