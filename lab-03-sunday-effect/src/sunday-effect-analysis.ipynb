      "id": "41ba20b2-6f29-465c-910a-5e70d7a3a557",
      "cell_type": "markdown",
      "source": "### Q15. Identification des produits \"dominants dimanche\"",
      "metadata": {}
    },
    {
      "id": "7717990f-bf4d-421f-8c7c-9a03a255d8a1",
      "cell_type": "code",
      "source": "cond_part    = df_comparatif['part_dimanche (%)'] >= 8\ncond_delta   = df_comparatif['delta_points'] >= 3\ncond_support = df_comparatif['support_dimanche'] >= 50\n\nproduits_dominants = df_comparatif[cond_part & cond_delta & cond_support]\n\nprint(\"--- Produits vérifiant les 3 conditions strictes ---\")\ndisplay(produits_dominants[['produit','part_dimanche (%)','delta_points','support_dimanche']])\nprint()\nprint(\"Diagnostic individuel des conditions :\")\nprint(f\"  • part_dimanche ≥ 8%  : {cond_part.sum()} produit(s)  → {df_comparatif[cond_part]['produit'].tolist()}\")\nprint(f\"  • delta ≥ +3 points   : {cond_delta.sum()} produit(s)  → {df_comparatif[cond_delta]['produit'].tolist()}\")\nprint(f\"  • support_dim ≥ 50    : {cond_support.sum()} produit(s) → {df_comparatif[cond_support]['produit'].tolist()}\")",
